{
	"name": "viewer",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:gh": "cross-env NODE_ENV=production vite build && node -e \"require('fs').writeFileSync('build/.nojekyll', '')\"",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.47.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^4.1.2",
		"@types/node": "^20.0.0",
		"@vitest/ui": "^2.1.8",
		"cross-env": "^10.1.0",
		"jsdom": "^25.0.1",
		"svelte": "^5.41.0",
		"svelte-check": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.1.10",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"@threlte/core": "^8.1.8",
		"@threlte/extras": "^9.0.0",
		"three": "^0.174.0"
	}
}
